# Sao chép file này thành .env.local (không commit .env.local — đã có trong .gitignore)
# và điền giá trị thật. Trên Vercel, khai báo các biến này trong Project Settings →
# Environment Variables, rồi Redeploy để áp dụng.

# ── WP REST API (Ngày 12) ──────────────────────────────────────────────────
WP_API_BASE_URL=https://xemiennam.datxesaigon.com/wp-json/wp/v2
WP_REVALIDATE_SECONDS=3600

# ── JWT booking (Ngày 20) — tạo booking_request qua WP REST API ───────────
# Tạo 1 user WordPress RIÊNG cho việc này (role Editor là đủ), KHÔNG dùng tài khoản
# Administrator cá nhân. Xem src/lib/api/wp-auth.ts.
WP_JWT_USERNAME=
WP_JWT_PASSWORD=

# ── Webhook revalidate (Ngày 20) — snippet WPCode ID 16 gọi vào /api/revalidate ──
# Chuỗi bí mật tự đặt (vd 1 đoạn ký tự ngẫu nhiên dài) — phải khớp với secret snippet
# WPCode đang gửi lên, nếu không endpoint sẽ từ chối (401). Xem src/app/api/revalidate/route.ts.
REVALIDATE_SECRET=

# ── Zalo OA (Ngày 21) — nút "Chat Zalo" nổi + trang /lien-he ──────────────
# Lấy ID này ở oa.zalo.me → chọn OA của Xe Miền Nam → phần thông tin quản trị sẽ có
# "ID Official Account" (1 dãy số dài, KHÔNG phải username/tên hiển thị). Thiếu biến này thì
# nút/link Chat Zalo tự ẩn đi (xem src/lib/zalo.ts) chứ không hiển thị link hỏng.
# Tiền tố NEXT_PUBLIC_ là bắt buộc — biến này cần lộ ra trình duyệt (client component).
NEXT_PUBLIC_ZALO_OA_ID=
