{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alodatxe-migration-spike",
  "main": "cloudflare/isr-worker.mjs",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS", "run_worker_first": true },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "alodatxe-migration-spike" }],
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "alodatxe-migration-cache" }],
  "d1_databases": [{
    "binding": "NEXT_TAG_CACHE_D1",
    "database_name": "alodatxe-migration-tags",
    "database_id": "00000000-0000-0000-0000-000000000000"
  }],
  "durable_objects": { "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }] },
  "migrations": [{ "tag": "cf-day2-queue-v1", "new_sqlite_classes": ["DOQueueHandler"] }],
  "vars": {
    "GOCAR_ENABLE_MOCK_FALLBACK": "false",
    "GOCAR_ADMIN_WIZARD_ENABLED": "false",
    "NEXT_INC_CACHE_R2_PREFIX": "migration-preview",
    "NEXT_CACHE_DO_QUEUE_MAX_REVALIDATION": "1",
    "NEXT_CACHE_DO_QUEUE_MAX_RETRIES": "2"
  }
}
